# NurseryPlaceFinder – Environment Variables
# Copy this file to .env.local and fill in your values

# ─── Supabase ────────────────────────────────────────────────────────────────
# Get these from your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key – NEVER expose to the browser. Server-side / admin only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Anthropic (AI chat – optional for MVP) ──────────────────────────────────
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Future integrations ─────────────────────────────────────────────────────
# Google Maps (for real map display)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-key-here

# Postcode API (for real distance calculation)
# POSTCODES_IO_BASE_URL=https://api.postcodes.io
